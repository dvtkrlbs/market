# Backend configuration. Local database credentials match compose.yaml.
# Defaults to DEVELOPMENT. Export ENVIRONMENT=PRODUCTION to skip .env loading.
ENVIRONMENT=DEVELOPMENT
DATABASE_URL=postgres://market:market@localhost:5432/market?sslmode=disable
HTTP_ADDR=:8080

# Required for serve. Generate with: openssl rand -base64 32
# Keep the same secret across restarts and server instances. Never commit it.
SESSION_SIGNING_KEY=

# Exact frontend origins, comma-separated, without trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
